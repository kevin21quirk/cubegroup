generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  STAFF
}

enum WorkflowState {
  EMAIL_RECEIVED
  ATTACHMENT_DOWNLOADED
  AI_PROCESSING
  VALIDATION_FAILED
  AWAITING_REVIEW
  SPREADSHEET_GENERATED
  SAVED_TO_SERVER
  READY_FOR_INVOICE
  INVOICE_SENT
  AWAITING_PAYMENT
  PAYMENT_RECEIVED
  UMBRELLA_INVOICE_SENT
  COMPLETED
  FAILED
}

enum ProcessingStatus {
  PENDING
  DOWNLOADING
  PROCESSING
  EXTRACTING
  VALIDATING
  GENERATING
  UPLOADING
  COMPLETED
  FAILED
  RETRY_NEEDED
}

enum AttachmentStatus {
  PENDING
  DOWNLOADED
  PROCESSING
  EXTRACTED
  FAILED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIAL
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
  OVERDUE
}

enum DocumentType {
  PDF
  DOCX
  XLSX
  CSV
  IMAGE
  OTHER
}

enum InvoiceType {
  CLIENT_INVOICE
  UMBRELLA_INVOICE
}

model User {
  id                String              @id @default(cuid())
  clerkId           String?             @unique
  email             String              @unique
  firstName         String?
  lastName          String?
  password          String?
  role              UserRole            @default(STAFF)
  companyId         String?
  company           Company?            @relation("UserCompany", fields: [companyId], references: [id])
  isActive          Boolean             @default(true)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  
  auditLogs         AuditLog[]
  notes             Note[]
  activities        Activity[]
  assignedTasks     Task[]
  createdCompanies  Company[]           @relation("CreatedBy")
  
  @@index([clerkId])
  @@index([email])
  @@index([role])
  @@index([companyId])
}

model Company {
  id                    String                @id @default(cuid())
  name                  String
  registrationNumber    String?               @unique
  vatNumber             String?
  industry              String?
  billingAddress        String?
  billingPostcode       String?
  billingCity           String?
  billingCountry        String                @default("United Kingdom")
  paymentTerms          Int                   @default(30)
  payrollFrequency      String                @default("Weekly")
  isActive              Boolean               @default(true)
  onboardingStatus      String                @default("Pending")
  riskNotes             String?
  complianceNotes       String?
  
  // Email processing configuration
  emailDomains          String[]              @default([])
  emailKeywords         String[]              @default([])
  spreadsheetTemplate   String?
  remoteFolder          String?
  
  createdById           String
  createdBy             User                  @relation("CreatedBy", fields: [createdById], references: [id])
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  
  umbrellaCompanyId     String?
  umbrellaCompany       UmbrellaCompany?      @relation(fields: [umbrellaCompanyId], references: [id])
  
  contacts              CompanyContact[]
  workers               Worker[]
  payrollSubmissions    PayrollSubmission[]
  invoices              Invoice[]
  feeStructures         FeeStructure[]
  documents             Document[]
  notes                 Note[]
  activities            Activity[]
  users                 User[]                @relation("UserCompany")
  
  @@index([name])
  @@index([isActive])
  @@index([umbrellaCompanyId])
}

model CompanyContact {
  id              String    @id @default(cuid())
  companyId       String
  company         Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  firstName       String
  lastName        String
  email           String
  phone           String?
  position        String?
  isPrimary       Boolean   @default(false)
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  @@index([companyId])
  @@index([email])
}

model UmbrellaCompany {
  id                    String                @id @default(cuid())
  name                  String                @unique
  registrationNumber    String?
  contactEmail          String
  contactPhone          String?
  address               String?
  postcode              String?
  city                  String?
  country               String                @default("United Kingdom")
  processingFee         Float                 @default(0)
  isActive              Boolean               @default(true)
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  
  companies             Company[]
  payrollEntries        PayrollEntry[]
  invoices              Invoice[]
  
  @@index([name])
  @@index([isActive])
}

model Worker {
  id                String          @id @default(cuid())
  companyId         String
  company           Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  
  // Basic Info
  contractorType    String?         // Company/Subcontractor
  firstName         String
  lastName          String
  tradingName       String?
  
  // Contact Details
  email             String?
  phone             String?
  addressLine1      String?
  addressLine2      String?
  city              String?
  postCode          String?
  
  // Tax & Employment
  nationalInsurance String?
  utrNumber         String?
  cisStatus         String?         // Gross/Net/Not Registered
  
  // Banking
  bankName          String?
  bankAccountNumber String?
  bankSortCode      String?
  paymentFrequency  String?         // Weekly/Monthly
  
  // Legacy fields
  employeeNumber    String?
  department        String?
  isActive          Boolean         @default(true)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  
  payrollEntries    PayrollEntry[]
  
  @@unique([companyId, email])
  @@index([companyId])
  @@index([lastName, firstName])
  @@index([nationalInsurance])
}

model PayrollSubmission {
  id                String          @id @default(cuid())
  companyId         String
  company           Company         @relation(fields: [companyId], references: [id])
  emailImportId     String?         @unique
  emailImport       EmailImport?    @relation(fields: [emailImportId], references: [id])
  payrollWeek       String
  payrollWeekStart  DateTime?
  payrollWeekEnd    DateTime?
  workflowState     WorkflowState   @default(EMAIL_RECEIVED)
  totalHours        Float           @default(0)
  totalGrossPay     Float           @default(0)
  totalCubeFees     Float           @default(0)
  totalUmbrellaFees Float           @default(0)
  validationErrors  Json?
  processingNotes   String?
  processedAt       DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  
  payrollEntries        PayrollEntry[]
  documents             Document[]
  invoices              Invoice[]
  tasks                 Task[]
  notes                 Note[]
  activities            Activity[]
  validationErrorsList  ValidationError[]
  generatedSpreadsheet  GeneratedSpreadsheet?
  
  @@index([companyId])
  @@index([workflowState])
  @@index([payrollWeek])
  @@index([createdAt])
}

model PayrollEntry {
  id                    String              @id @default(cuid())
  payrollSubmissionId   String
  payrollSubmission     PayrollSubmission   @relation(fields: [payrollSubmissionId], references: [id], onDelete: Cascade)
  workerId              String?
  worker                Worker?             @relation(fields: [workerId], references: [id])
  umbrellaCompanyId     String?
  umbrellaCompany       UmbrellaCompany?    @relation(fields: [umbrellaCompanyId], references: [id])
  
  workerName            String
  hoursWorked           Float
  hourlyRate            Float
  grossPay              Float
  cubeFee               Float               @default(0)
  umbrellaFee           Float               @default(0)
  netToWorker           Float               @default(0)
  department            String?
  projectSite           String?
  payrollWeek           String
  notes                 String?
  rawData               Json?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  
  @@index([payrollSubmissionId])
  @@index([workerId])
  @@index([payrollWeek])
}

model Invoice {
  id                    String              @id @default(cuid())
  invoiceNumber         String              @unique
  invoiceType           InvoiceType
  companyId             String?
  company               Company?            @relation(fields: [companyId], references: [id])
  umbrellaCompanyId     String?
  umbrellaCompany       UmbrellaCompany?    @relation(fields: [umbrellaCompanyId], references: [id])
  payrollSubmissionId   String?
  payrollSubmission     PayrollSubmission?  @relation(fields: [payrollSubmissionId], references: [id])
  
  issueDate             DateTime            @default(now())
  dueDate               DateTime
  subtotal              Float
  vatAmount             Float               @default(0)
  vatRate               Float               @default(20)
  totalAmount           Float
  paidAmount            Float               @default(0)
  status                InvoiceStatus       @default(DRAFT)
  paymentStatus         PaymentStatus       @default(UNPAID)
  
  billingName           String
  billingAddress        String?
  billingPostcode       String?
  billingCity           String?
  billingCountry        String              @default("United Kingdom")
  
  notes                 String?
  termsAndConditions    String?
  pdfUrl                String?
  sentAt                DateTime?
  paidAt                DateTime?
  
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  
  items                 InvoiceItem[]
  payments              Payment[]
  documents             Document[]
  
  @@index([invoiceNumber])
  @@index([companyId])
  @@index([umbrellaCompanyId])
  @@index([status])
  @@index([paymentStatus])
  @@index([issueDate])
}

model InvoiceItem {
  id              String    @id @default(cuid())
  invoiceId       String
  invoice         Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description     String
  quantity        Float     @default(1)
  unitPrice       Float
  vatRate         Float     @default(20)
  amount          Float
  createdAt       DateTime  @default(now())
  
  @@index([invoiceId])
}

model Payment {
  id              String        @id @default(cuid())
  invoiceId       String
  invoice         Invoice       @relation(fields: [invoiceId], references: [id])
  amount          Float
  paymentDate     DateTime
  paymentMethod   String?
  reference       String?
  notes           String?
  bankReference   String?
  reconciled      Boolean       @default(false)
  reconciledAt    DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  
  @@index([invoiceId])
  @@index([paymentDate])
  @@index([reconciled])
}

model FeeStructure {
  id              String    @id @default(cuid())
  companyId       String
  company         Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  feeType         String
  feeAmount       Float
  feePercentage   Float?
  isActive        Boolean   @default(true)
  effectiveFrom   DateTime  @default(now())
  effectiveTo     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  @@index([companyId])
  @@index([isActive])
}

model Document {
  id                    String              @id @default(cuid())
  filename              String
  originalFilename      String
  fileSize              Int
  mimeType              String
  documentType          DocumentType
  storageUrl            String
  storagePath           String
  
  companyId             String?
  company               Company?            @relation(fields: [companyId], references: [id])
  payrollSubmissionId   String?
  payrollSubmission     PayrollSubmission?  @relation(fields: [payrollSubmissionId], references: [id])
  invoiceId             String?
  invoice               Invoice?            @relation(fields: [invoiceId], references: [id])
  
  extractedText         String?
  metadata              Json?
  isProcessed           Boolean             @default(false)
  processedAt           DateTime?
  uploadedAt            DateTime            @default(now())
  
  @@index([companyId])
  @@index([payrollSubmissionId])
  @@index([invoiceId])
  @@index([documentType])
}

model EmailImport {
  id                String              @id @default(cuid())
  messageId         String              @unique
  threadId          String?
  from              String
  to                String
  subject           String
  bodyText          String?
  bodyHtml          String?
  receivedAt        DateTime
  hasAttachments    Boolean             @default(false)
  attachmentCount   Int                 @default(0)
  processingStatus  ProcessingStatus    @default(PENDING)
  isProcessed       Boolean             @default(false)
  processedAt       DateTime?
  detectedCompany   String?
  detectedWeek      String?
  errorMessage      String?
  retryCount        Int                 @default(0)
  lastRetryAt       DateTime?
  metadata          Json?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  
  payrollSubmission PayrollSubmission?
  attachments       Attachment[]
  workflowLogs      WorkflowLog[]
  
  @@index([messageId])
  @@index([from])
  @@index([receivedAt])
  @@index([isProcessed])
  @@index([processingStatus])
}

model Task {
  id                    String              @id @default(cuid())
  title                 String
  description           String?
  priority              String              @default("Medium")
  status                String              @default("Pending")
  dueDate               DateTime?
  assignedToId          String?
  assignedTo            User?               @relation(fields: [assignedToId], references: [id])
  payrollSubmissionId   String?
  payrollSubmission     PayrollSubmission?  @relation(fields: [payrollSubmissionId], references: [id])
  completedAt           DateTime?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  
  @@index([assignedToId])
  @@index([status])
  @@index([dueDate])
}

model Note {
  id                    String              @id @default(cuid())
  content               String
  companyId             String?
  company               Company?            @relation(fields: [companyId], references: [id])
  payrollSubmissionId   String?
  payrollSubmission     PayrollSubmission?  @relation(fields: [payrollSubmissionId], references: [id])
  createdById           String
  createdBy             User                @relation(fields: [createdById], references: [id])
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  
  @@index([companyId])
  @@index([payrollSubmissionId])
  @@index([createdById])
}

model Activity {
  id                    String              @id @default(cuid())
  action                String
  description           String
  entityType            String?
  entityId              String?
  metadata              Json?
  companyId             String?
  company               Company?            @relation(fields: [companyId], references: [id])
  payrollSubmissionId   String?
  payrollSubmission     PayrollSubmission?  @relation(fields: [payrollSubmissionId], references: [id])
  userId                String
  user                  User                @relation(fields: [userId], references: [id])
  createdAt             DateTime            @default(now())
  
  @@index([userId])
  @@index([companyId])
  @@index([payrollSubmissionId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model AuditLog {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id])
  action          String
  entityType      String
  entityId        String
  changes         Json?
  ipAddress       String?
  userAgent       String?
  createdAt       DateTime  @default(now())
  
  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model SystemConfig {
  id              String    @id @default(cuid())
  key             String    @unique
  value           String
  description     String?
  isEncrypted     Boolean   @default(false)
  updatedAt       DateTime  @updatedAt
  
  @@index([key])
}

model Attachment {
  id                String            @id @default(cuid())
  emailImportId     String
  emailImport       EmailImport       @relation(fields: [emailImportId], references: [id], onDelete: Cascade)
  
  filename          String
  originalFilename  String
  fileSize          Int
  mimeType          String
  documentType      DocumentType
  
  storageUrl        String?
  storagePath       String?
  localPath         String?
  
  status            AttachmentStatus  @default(PENDING)
  extractedData     Json?
  extractedText     String?
  errorMessage      String?
  
  isProcessed       Boolean           @default(false)
  processedAt       DateTime?
  downloadedAt      DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  
  @@index([emailImportId])
  @@index([status])
  @@index([documentType])
}

model ValidationError {
  id                    String              @id @default(cuid())
  payrollSubmissionId   String
  payrollSubmission     PayrollSubmission   @relation(fields: [payrollSubmissionId], references: [id], onDelete: Cascade)
  
  errorType             String
  errorMessage          String
  fieldName             String?
  rowIndex              Int?
  severity              String              @default("ERROR")
  isResolved            Boolean             @default(false)
  resolvedAt            DateTime?
  resolvedBy            String?
  metadata              Json?
  createdAt             DateTime            @default(now())
  
  @@index([payrollSubmissionId])
  @@index([isResolved])
  @@index([severity])
}

model GeneratedSpreadsheet {
  id                    String              @id @default(cuid())
  payrollSubmissionId   String              @unique
  payrollSubmission     PayrollSubmission   @relation(fields: [payrollSubmissionId], references: [id], onDelete: Cascade)
  
  filename              String
  fileSize              Int?
  localPath             String?
  remotePath            String?
  storageUrl            String?
  
  isUploaded            Boolean             @default(false)
  uploadedAt            DateTime?
  uploadError           String?
  
  templateUsed          String?
  generationMetadata    Json?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  
  @@index([payrollSubmissionId])
  @@index([isUploaded])
}

model WorkflowLog {
  id                String        @id @default(cuid())
  emailImportId     String?
  emailImport       EmailImport?  @relation(fields: [emailImportId], references: [id], onDelete: Cascade)
  
  state             WorkflowState
  message           String
  metadata          Json?
  errorDetails      String?
  duration          Int?
  createdAt         DateTime      @default(now())
  
  @@index([emailImportId])
  @@index([state])
  @@index([createdAt])
}
