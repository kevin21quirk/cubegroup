# Database
DATABASE_URL="postgresql://user:password@localhost:5432/cubegroup?schema=public"

# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# Anthropic AI (Claude)
ANTHROPIC_API_KEY=sk-ant-xxx
# Optional – defaults to claude-sonnet-4-6
ANTHROPIC_MODEL=claude-sonnet-4-6

# Vercel Blob Storage
BLOB_READ_WRITE_TOKEN=vercel_blob_xxx

# ── Gmail / Google OAuth ──────────────────────────────────────────────────────
# Create credentials at https://console.cloud.google.com → APIs & Services → OAuth 2.0
GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxx
# Must match what you register in Google Cloud Console as an Authorised Redirect URI
GOOGLE_REDIRECT_URI=https://yourapp.vercel.app/api/auth/google/callback
# Optional: set as fallback if DB token is not stored (usually left blank)
GOOGLE_REFRESH_TOKEN=

# Gmail label to poll for incoming payroll emails (default: Payroll-Incoming)
GMAIL_MONITOR_LABEL=Payroll-Incoming
# Label applied after successful processing (default: Payroll-Processed)
GMAIL_PROCESSED_LABEL=Payroll-Processed
# Optional: restrict polling to a specific Gmail address
GMAIL_MONITOR_EMAIL=kevin.s.quirk@gmail.com

# ── Cron security ─────────────────────────────────────────────────────────────
# Vercel automatically sends this in Authorization: Bearer <CRON_SECRET> on cron calls
CRON_SECRET=generate-a-long-random-string-here

# ── Xero Integration ──────────────────────────────────────────────────────────
# Create an app at https://developer.xero.com/myapps
XERO_CLIENT_ID=xxx
XERO_CLIENT_SECRET=xxx
XERO_REDIRECT_URI=http://localhost:3000/api/auth/xero/callback
# Default account codes used when creating invoices/bills in Xero
XERO_DEFAULT_INCOME_ACCOUNT=200
XERO_DEFAULT_EXPENSE_ACCOUNT=400

# ── QuickBooks Integration ────────────────────────────────────────────────────
# Create an app at https://developer.intuit.com/app/developer/qbo/docs/develop
QUICKBOOKS_CLIENT_ID=xxx
QUICKBOOKS_CLIENT_SECRET=xxx
QUICKBOOKS_REDIRECT_URI=http://localhost:3000/api/auth/quickbooks/callback
# sandbox | production
QUICKBOOKS_ENV=sandbox
# Default expense account ref used when creating bills
QB_DEFAULT_EXPENSE_ACCOUNT=63

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# AWS (Future Migration)
# AWS_REGION=eu-west-2
# AWS_ACCESS_KEY_ID=xxx
# AWS_SECRET_ACCESS_KEY=xxx
# AWS_S3_BUCKET=xxx
